# Copy this file to .env and fill in the values. .env is gitignored.
#
# Fill in EITHER the Azure block (what Sherpa supplies) OR the OpenAI block.
# If both are present, Azure wins.
#
# *_API_KEY must be base64-encoded, not the raw key. Encode with:
#   python3 -c "import base64; print(base64.b64encode(b'YOUR_RAW_KEY').decode())"
# This is not encryption — it's decoded on load in app/config.py — but it keeps
# the raw key from sitting in plain text in a file you might `cat` or screen-share.

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# --- OpenAI (fallback) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-2024-08-06
